# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit your real API key.

# Required for the Earnings Summarizer (and any other Claude-powered tool).
# Get one from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Note: the Financial Models tool fetches data from SEC EDGAR (keyless,
# unlimited). The SEC asks API clients to identify themselves via User-Agent
# with a contact email. Defaults to a placeholder; override here for production.
# SEC_USER_AGENT="Your Name your@email.com"
